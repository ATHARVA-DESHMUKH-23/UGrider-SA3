<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="sa3_environment">

  <link name="world"/>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <xacro:macro name="environment_object"
               params="name parent xyz rpy mesh scale">

    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh}" scale="${scale}"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh}" scale="${scale}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_fixed_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

  </xacro:macro>

</robot>