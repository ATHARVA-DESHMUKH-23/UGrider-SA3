<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="sa3_robots_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- By default, set up controllers for simulation. This won't work on real hardware -->
                <plugin>mock_components/GenericSystem</plugin>
            </hardware>
            <joint name="robot1_J1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot1_J1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot1_J2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot1_J2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot1_J3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot1_J3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot1_J4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot1_J4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot1_J5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot1_J5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot1_J6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot1_J6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot2_J1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot2_J1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot2_J2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot2_J2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot2_J3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot2_J3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot2_J4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot2_J4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot2_J5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot2_J5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot2_J6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot2_J6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot3_J1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot3_J1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot3_J2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot3_J2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot3_J3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot3_J3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot3_J4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot3_J4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot3_J5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot3_J5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot3_J6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot3_J6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot4_J1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot4_J1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot4_J2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot4_J2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot4_J3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot4_J3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot4_J4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot4_J4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot4_J5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot4_J5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="robot4_J6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['robot4_J6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
